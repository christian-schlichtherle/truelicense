<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>global.namespace.truelicense</groupId>
        <artifactId>truelicense</artifactId>
        <version>4.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>truelicense-tests</artifactId>

    <name>TrueLicense Tests</name>
    <description>
        The TrueLicense Tests module provides the integration tests.
    </description>

    <properties>
        <gpg.skip>true</gpg.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
    </properties>

    <build>
        <plugins>
            <!--
              ~ Produce an (empty) jar here even though this module is never installed or deployed.
              ~
              ~ maven.deploy.skip above does NOT cover the Central Portal. central-publishing-maven-plugin declares
              ~ <extensions>true</extensions> in the root POM, and its lifecycle participant removes
              ~ maven-deploy-plugin - the only thing that reads maven.deploy.skip - and injects a `publish` goal into
              ~ the deploy phase of EVERY module. There is no per-module opt-out: the participant only declines to
              ~ install itself if some module declares the plugin with its own executions, and that decision is
              ~ global. skipPublishing is no help either - it is evaluated after staging, so `deploy
              ~ -DskipPublishing=true` still fails here.
              ~
              ~ Without a jar, that injected goal aborts the release at the very last module with "The packaging for
              ~ this project did not assign a file to the build artifact", because the root POM sets skipIfEmpty and
              ~ this module has no main classes. An empty jar costs nothing - it is not installed, not deployed, and
              ~ excludeArtifacts in the root POM keeps it out of the uploaded bundle. All of this was measured
              ~ against a release-version dry run, not inferred; see CLAUDE.md.
              -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <skipIfEmpty>false</skipIfEmpty>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
